DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=
DJANGO_TIME_ZONE=
DATABASE_URL=
CORS_ALLOWED_ORIGINS=
API_BASE_PATH=
MEDIA_ROOT=
MAX_UPLOAD_MB=
AUTH_TOKEN_TTL_HOURS=
MATCH_THRESHOLD=
MAX_PENDING_CLAIMS=
ITEM_EXPIRY_DAYS=
HANDOVER_CODE_LENGTH=
FINDER_KARMA_POINTS=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# E-mail copies of notifications (blank SMTP_HOST = printed to the console instead).
# Gmail: smtp.gmail.com, port 587, SMTP_SECURE=false, and an App Password.
SEND_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Common inbox: when set, every e-mail goes here instead of each user's own address.
MAIL_TO=
# Base URL used for links in e-mails, e.g. http://192.168.1.20:5173
APP_BASE_URL=

# Local MongoDB, e.g. mongodb://localhost:27017/ (blank = SQLite file). Database name defaults to findit.
DATABASE_URI=
MONGODB_DB=

# AI match recommendation via local Ollama (blank = on, qwen2.5:3b at http://127.0.0.1:11434). AI_PROVIDER=off disables it.
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=
AI_REVIEWS_PER_ITEM=
